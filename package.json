{
  "name": "token-monitor",
  "version": "1.0.0",
  "description": "Token usage monitor for DeepSeek and MiMo",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build:main && npm run build:preload && concurrently \"vite\" \"electron .\""
  },
  "keywords": [],
  "author": "Token Monitor",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
